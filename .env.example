# Next.js talks to the MediaMTX control API on the host.
MEDIAMTX_API_URL=http://127.0.0.1:9997

# Base URL returned to the browser. The app appends /tapo-main/.
MEDIAMTX_WEBRTC_URL=http://localhost:8889

# Hosts MediaMTX advertises for WebRTC. Include 127.0.0.1 for this machine
# and this computer's LAN address so a phone on the same network can play video.
WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

# Address the Nest display uses to fetch HLS. Leave unset to detect a LAN address.
# CAST_HOST=192.168.1.20

# MySQL, published by docker compose on localhost only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tapocam
MYSQL_PASSWORD=tapocam
MYSQL_DATABASE=tapocam
MYSQL_ROOT_PASSWORD=tapocam-root

# Folder of plugins this app can install. Defaults to ../tapocam-extends/plugins.
# PLUGIN_CATALOG=../tapocam-extends/plugins

# Saved camera video. Defaults to ./recordings. MediaMTX and playback use the same folder.
# RECORDINGS_DIR=/path/to/recordings
